# ------------------------------------------------------------------------------
# Local environment and secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
Agents_Experience/.env
Agents_Experience/.env.*
!Agents_Experience/.env.example

# Local user/API configuration. Contains model endpoint and key-like settings.
Agents_Experience/user_setting.ini

# Streamlit secrets are local; config.toml is allowed.
.streamlit/secrets.toml

# ------------------------------------------------------------------------------
# Project data stores and generated market data
# ------------------------------------------------------------------------------
data/*
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*

# Keep possible checked-in placeholders.
!data/.gitkeep

# ------------------------------------------------------------------------------
# Agent run outputs
# ------------------------------------------------------------------------------
Agents_Experience/logs/
Agents_Experience/results/
Agents_Experience/**/*.log
Agents_Experience/**/*_portfolio_*.csv
Agents_Experience/**/*_decision_*.log

# Historical/manual run dumps that should not be versioned.
images/Qwen3-max_251116完整结果记录/

