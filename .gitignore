# ==============================================================================
# StockM1 / IGE
# Ignore rules control Git discovery, not retention or cleanup. Research ledgers,
# original disclosures, failed-run evidence and replay scripts in .tmp/ are local
# records to preserve; do not treat every ignored path as disposable.
# Already tracked files are unaffected by these rules.
# ==============================================================================

# ------------------------------------------------------------------------------
# Python bytecode and caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.cache/

# ------------------------------------------------------------------------------
# Build and packaging artifacts
# ------------------------------------------------------------------------------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# ------------------------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------------------------
.venv/
.venv-*/
venv/
ENV/
env/
env.bak/
venv.bak/
__pypackages__/

# ------------------------------------------------------------------------------
# Test, coverage, lint, type-checker caches
# ------------------------------------------------------------------------------
.pytest_cache/
.test-cache-*/
.test-tmp-*/
.deepeval/
.benchmarks/
.testmondata
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
# Explicit pytest --basetemp directories created at the repository root.
/pytest-*/
/pytest-of-*/

# ------------------------------------------------------------------------------
# Jupyter / notebook checkpoints
# ------------------------------------------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# Local environment and secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
Agents_Experience/.env
Agents_Experience/.env.*
!Agents_Experience/.env.example

# Local user/API configuration. Contains model endpoint and key-like settings.
Agents_Experience/user_setting.ini

# Streamlit secrets are local; config.toml is allowed.
.streamlit/secrets.toml
# Optional local override of the normally external encrypted credential store.
runtime-credentials.json

# ------------------------------------------------------------------------------
# Project data stores and generated market data
# ------------------------------------------------------------------------------
data/*
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Keep possible checked-in placeholders.
!data/.gitkeep

# ------------------------------------------------------------------------------
# Agent run outputs
# ------------------------------------------------------------------------------
Agents_Experience/logs/
Agents_Experience/results/
portfolio-research-logs/
Agents_Experience/**/*.log
Agents_Experience/**/*_portfolio_*.csv
Agents_Experience/**/*_decision_*.log

# Historical/manual run dumps that should not be versioned.
images/Qwen3-max_251116完整结果记录/

# ------------------------------------------------------------------------------
# Generic logs and runtime files
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------------------------
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.orig
*.rej

# ------------------------------------------------------------------------------
# IDE and editor files
# ------------------------------------------------------------------------------
.idea/
.vscode/
.agents/
.codex/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# OS metadata
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# Optional local exports. Do not ignore all CSV files globally, because future
# fixtures or small sample datasets may be intentionally committed.
# Source PDFs, JSON contracts, fixtures and test modules are intentionally not
# ignored globally. Put local CLI exports/downloads in the directories below
# (or .tmp/) instead of hiding all files with those extensions.
# ------------------------------------------------------------------------------
exports/
reports/
# Optional third-party reference checkouts. StockM1 must never import these.
MiroFish/
TrendRadar/
