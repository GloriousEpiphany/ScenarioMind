# StockM1 情景推演运行配置
# 复制为项目根目录 .env 后填值。严禁提交 .env；程序不会把空值视为已配置。

# 大模型只负责自然语言结构化与文字解释，不得生成收益率、概率或目标价。
STOCKM1_SCENARIO_LLM_ENABLED=0
SCENARIO_LLM_API_BASE=https://your-openai-compatible-provider.example/v1
SCENARIO_LLM_API_KEY=
SCENARIO_LLM_MODEL=
SCENARIO_LLM_TIMEOUT_SECONDS=90

# 兼容现有 Agents_Experience/.env 的旧变量；新部署无需重复填写。
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL=

# 公共研究源。腾讯日线无需密钥；AKShare 仍受上游站点可用性和使用条款约束。
STOCKM1_TENCENT_ENABLED=1
STOCKM1_AKSHARE_ENABLED=1

# TuShare Pro：安装对应 SDK 后填 token。具体接口还受账户积分/权限约束。
STOCKM1_TUSHARE_ENABLED=0
TUSHARE_TOKEN=

# RQData：安装 rqdatac 后按所购服务填写。不同版本可使用账号密码或配置文件。
STOCKM1_RQDATA_ENABLED=0
RQDATA_USERNAME=
RQDATA_PASSWORD=
RQDATAC2_CONF=

# 模型生产闸门。只有真实样本外校准结果通过后才能登记 active。
STOCKM1_MODEL_MIN_SAMPLES=20
STOCKM1_MODEL_MAX_QUANTILE_COVERAGE_ERROR=0.08
STOCKM1_MODEL_MAX_CVAR_EXCEEDANCE_RATE=0.15
